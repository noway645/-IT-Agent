git# ===== 企业 IT 助手 环境变量示例 =====
# 复制为 .env 并填入真实值，.env 已被 .gitignore 忽略

# ----- LLM -----
# 智谱 API Key（必填）
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# LangChain verbose 调试日志（true/false）
LANGCHAIN_VERBOSE=false

# ----- PostgreSQL（P0 上线改造）-----
PG_HOST=localhost
PG_PORT=5432
PG_DB=it_helper
PG_USER=it_helper
PG_PASSWORD=change_me_strong_password
# 连接池大小
PG_POOL_MIN=1
PG_POOL_MAX=10

# ----- 速率限制 -----
RATE_LIMIT_PER_MIN=20

# ----- 服务监听（Docker 容器需 0.0.0.0）-----
SERVER_HOST=0.0.0.0
SERVER_PORT=7860
